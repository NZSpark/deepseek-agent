# ===== DeepSeek Web-to-API Bridge 配置模板 =====
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8000

# ---- 上游等待 / 重试 ----
# 单轮生成总超时（秒）。必须小于 Pi 侧 HTTP 客户端的超时。
DEEPSEEK_TIMEOUT=180
# 最大尝试次数（1 = 不重试）。重试阶梯：
#   第 1 次用现有会话；中间几次恢复同一个会话；最后一次换新会话 + 播种历史。
DEEPSEEK_RETRIES=2
# 重试退避基数（秒）；第 n 次重试等待 RETRY_BACKOFF_S * n。
RETRY_BACKOFF_S=1.0

# ---- 结束判定轮询 ----
# 轮询间隔（秒）。
POLL_INTERVAL_S=1.5
# 文本完全相同时，连续这么多次即判定生成结束。
STABLE_POLLS=2
# 仅长度不再增长时，需连续这么多次才判定结束（更保守）。
LEN_STABLE_POLLS=4
# 新建 / 恢复页面后等待输入框就绪的超时（毫秒）。
READY_TIMEOUT_MS=15000

# ---- 会话生命周期 ----
# 启动时忽略已保存的会话，直接开新会话（true/false）。
# 只在有“播种”能力的前提下才安全：新会话首轮会重放历史，否则模型收不到上下文。
DEEPSEEK_NEW_SESSION=false
# 网页会话超过以下任一阈值后，下一轮自动轮转到新会话并播种上下文（0 = 禁用该维度）。
SESSION_MAX_TURNS=60
SESSION_MAX_TOKENS=60000
# 播种（新会话时重放历史）的字符数预算；超出时保留最近的消息。
SEED_MAX_CHARS=12000
# 每 N 轮轮询检查一次“是否到顶”（避免每轮对整页做 innerText 扫描）。
CAP_CHECK_EVERY=4
# “会话到顶”提示语的匹配规则，用 "||" 分隔多条正则（大小写不敏感）。
CAP_NOTICE_PATTERNS=达到对话长度上限||对话长度上限||已达到长度限制||达到长度限制||开启新对话||开始新的聊天

# ---- 按任务隔离会话 ----
# 打开后按请求头（同一取值 = 同一任务）隔离网页会话：不同任务各自持有独立会话，
# 互不污染上下文；关闭则回到“全部请求共用一个会话”的旧行为。
SESSION_SCOPING=true
# 当请求头与 user 字段都缺失时，是否允许按 User-Agent 自动分桶：
# 不同 AI 编程助手（Cline、Cursor、Aider 等）会自动各用一条独立会话，无需手动配置。
# 关闭后退回旧的“默认桶，全局共用”行为。自动分桶的桶数受 MAX_SESSION_BUCKETS 约束。
SESSION_SCOPING_BY_UA=true
# 用哪个请求头承载任务标识（OpenAI 的 user 字段会作为兜底）。
SESSION_KEY_HEADER=X-DeepSeek-Session
# 单个 key 的长度上限；超出部分会被截断。
SESSION_KEY_MAX_LEN=64
# 同时在用的会话桶数量上限（每个桶一条浏览器页面）。
# 超出时**回收最久未用**的页面（会话状态保留，下次自动重开同一会话），不会再报错。
# 0 = 不允许额外的会话桶（一律走默认会话）；想彻底关闭分桶请用 SESSION_SCOPING=false。
MAX_SESSION_BUCKETS=8
# 空闲页面的回收间隔（秒）：超过这段时间没被用过的桶页面会被关闭；0 = 不按空闲回收。
BUCKET_IDLE_TTL_S=900
# 是否允许**按桶并发**（每个会话桶一把锁）。默认 false = 所有桶串行。
# 注意：分桶默认只是“上下文隔离”，不是并发能力；打开后会同时驱动多个网页会话，
# 可能触发风控，请自行评估。
PARALLEL_BUCKETS=false
# 等待某个会话桶锁的最长时间（秒）：0 = 一直等（默认，保持旧行为）。
# >0 时，同一会话桶的请求堆叠会快速返回 503（upstream_busy），
# 而不是无限排队、拖到客户端自己超时。不同桶互不影响。
BUCKET_LOCK_TIMEOUT_S=0

# ---- 运行模式 / 调试 ----
# 无头模式（CI / 无显示环境）；首次登录需设为 false。
HEADLESS=false
# 打开后每轮轮询打印状态；同时才会启用 /debug/dom 诊断端点（默认 404）。
DEEPSEEK_DEBUG=false

# ---- 路径 ----
# Chromium 持久化用户目录（保存登录态，勿提交）。
USER_DATA_DIR=./user_data
# 会话状态落盘文件（JSON）：默认桶的 url / turns / est_tokens / cap_hit / …
# 直接放在顶层（与历史格式兼容），其余会话桶放在 sessions 下。
SESSION_FILE=./user_data/.deepseek_session
# 代码 / 回复落盘目录（客户端可用 output_dir 覆盖）。
OUTPUT_DIR=./output

# ---- DOM 选择器（网页版改版时在此调整）----
# INPUT_SELECTORS 用 "||" 分隔多个候选选择器。
RESPONSE_SELECTORS=.ds-markdown, .markdown-body, div[class*="markdown"]
INPUT_SELECTORS=textarea[placeholder*="发送"]||textarea[placeholder*="Send"]||#chat-input||textarea
READY_SELECTOR=textarea, [contenteditable="true"]
CODE_BLOCK_SELECTOR=pre
CODE_TAG_SELECTOR=code
